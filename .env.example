# ==========================================
# LIFE RPG ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Database Connection URL
# For local development (zero-configuration SQLite):
DATABASE_URL="file:./dev.db"

# For remote PostgreSQL (e.g. Supabase, Neon, Railway, Render):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/liferpg?sslmode=require"

# JWT Secret for signing authentication tokens
JWT_SECRET="your_production_secure_jwt_secret_key_here"

# Backend Server Port
PORT=5000

# CORS Allowed Origin (Frontend Application URL)
# Local: http://localhost:5173
# Production: https://life-rpg.yourdomain.com
CORS_ORIGIN="http://localhost:5173"

# Node Environment ('development' | 'production')
NODE_ENV="development"
