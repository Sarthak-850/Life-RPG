# Database connection string
# For local SQLite: file:./dev.db
# For PostgreSQL (e.g. Supabase, Neon, Railway): postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for signing auth tokens
JWT_SECRET="your_jwt_secret_key_here"

# Server Port
PORT=5000

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Node Environment
NODE_ENV="development"
